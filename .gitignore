# Local .terraform directories
**/.terraform/*

# Terraform state files (may contain sensitive data)
*.tfstate
*.tfstate.*

# Saved plan files (can contain sensitive data internally)
tfplan
*.tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which usually contain sensitive data
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock file variance across platforms (optional; comment out to commit it)
# .terraform.lock.hcl

# Personal interview prep notes -- not part of the take-home submission
docs/
prep/
